# ---------------------------------------------------------------
# D&D AI Dungeon Master — environment template
# Copy to .env.local and fill in real values. NEVER commit real keys.
# These same values must also be set as Vercel env vars (production).
# ---------------------------------------------------------------

# Neon serverless Postgres (Phase 0 storage)
# Pooled connection string. Auto-injected when provisioned via the Vercel
# Marketplace (Storage -> Neon). Secret — server-side only.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require

# Groq AI (Prep + Runtime)
GROQ_API_KEY=your-groq-key-here

# Optional AI provider overrides
# Default Groq model is openai/gpt-oss-120b (set in code). Override if needed:
# PREP_AI_PROVIDER=groq
# PREP_AI_MODEL=openai/gpt-oss-120b
# RUNTIME_AI_PROVIDER=groq
# RUNTIME_AI_MODEL=openai/gpt-oss-120b
